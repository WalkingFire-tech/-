@charset "utf-8";

#app { padding: 30px 30px 5px; background-color: transparent; font-family: =
PingFangSC, "PingFang SC"; box-sizing: border-box; }

.row { display: flex; }

.col { flex: 1 1 0%; margin-left: 40px; min-width: 250px; }

.col:first-child { margin-left: 0px; }

.col-header { display: flex; color: rgb(0, 0, 0); line-height: 18px; }

.col-header h3 { font-size: 14px; font-family: PingFangSC, "PingFang SC"; f=
ont-weight: 500; color: rgb(0, 0, 0); flex: 1 1 0%; }

.col-header-more { font-size: 11px; font-weight: 400; }

.col-header-more span { vertical-align: middle; }

.header { margin-bottom: 30px; }

.search-box { height: 28px; border-radius: 4px; border: 1px solid rgb(197, =
197, 197); display: flex; line-height: 26px; }

.search-box .icon-search { margin: 8px 4px 8px 6px; }

.search-box input { flex: 1 1 0%; font-size: 12px; color: rgb(0, 0, 0); }

.search-box input::placeholder { color: rgb(102, 102, 102); }

.search-box .search-btn { width: 42px; height: 24px; background: linear-gra=
dient(rgb(44, 184, 255) 0%, rgb(40, 87, 255) 100%); border-radius: 2px; fon=
t-size: 12px; font-family: PingFangSC, "PingFang SC"; font-weight: 500; col=
or: rgb(255, 255, 255); margin: 2px; cursor: pointer; }

.search-hotwords { margin-top: 10px; }

.search-hotwords-header { font-size: 13px; color: rgb(51, 51, 51); }

.search-hotwords-item { float: left; border-radius: 2px; border: 2px solid =
rgba(197, 197, 197, 0.3); margin-right: 8px; margin-top: 8px; color: rgb(51=
, 51, 51); font-size: 12px; cursor: pointer; font-weight: 400; transition: =
0.2s linear; }

.search-hotwords-item a { padding: 2px 5px; }

.search-hotwords-item:hover { color: rgb(0, 0, 0); font-weight: 500; }

.col-applications ul { width: 100%; display: flex; }

.col-applications .list-item { width: 20%; border-radius: 2px; text-align: =
center; border: 2px solid transparent; margin-top: 8px; transition: 0.2s li=
near; }

.association .list-item { width: 25%; }

.col-applications .list-item:hover { border-color: rgba(197, 197, 197, 0.3)=
; }

.col-applications .list-item a { width: 100%; height: 100%; padding: 10px 0=
px; box-sizing: border-box; }

.col-applications .list-item img { width: 30px; height: 30px; margin-bottom=
: 10px; background: rgb(174, 197, 242); border-radius: 3px; }

.col-applications .list-item span { font-size: var(--fontSize); line-height=
: var(--fontSize); color: rgb(0, 0, 0); display: block; }

.container-hotlist .col-body { margin-top: 18px; }

.col-recommend .list-item { margin-bottom: 16px; }

.avatar { width: var(--fontSize); height: var(--fontSize); border-radius: 5=
0%; margin-right: 8px; margin-top: 2px; }

.hotlist-item { line-height: 18px; }

.hotlist-item a { display: flex; }

.hotlist-item .list-item-text { flex: 1 1 0%; font-size: var(--fontSize); f=
ont-weight: 400; color: rgb(37, 38, 49); transition: 0.2s linear; }

.hotlist-item:hover .list-item-text { color: rgb(40, 87, 255); font-size: v=
ar(--fontSize); font-weight: 500; }

.col-paper .list-item { margin-bottom: 18px; }

.col-paper .list-item-index { width: 14px; height: 14px; background: rgba(2=
55, 255, 255, 0.5); border-radius: 1px; display: inline-block; text-align: =
center; color: rgb(51, 51, 51); font-size: 11px; line-height: 14px; margin:=
 2px 8px 0px 0px; }

.list-item:nth-child(1) .list-item-index { color: rgb(224, 32, 32); }

.list-item:nth-child(2) .list-item-index { color: rgb(250, 100, 0); }

.list-item:nth-child(3) .list-item-index { color: rgb(247, 173, 0); }

.hotness-box { width: 40px; overflow: hidden; margin-left: 16px; }

.hotness-box .hotness-num { font-size: 10px; color: rgb(142, 142, 142); }

.col-activity .list-item { margin-bottom: 8px; height: 54px; }

.col-activity .list-item a { display: flex; }

.circle-line { position: relative; }

.circle-line .circle-outter { width: 10px; height: 10px; border: 1px solid =
rgb(80, 82, 90); border-radius: 50%; position: relative; margin: 6px 0px; }

.circle-line .circle-inner { width: 6px; height: 6px; background: rgb(80, 8=
2, 90); border-radius: 50%; position: absolute; top: 50%; left: 50%; transf=
orm: translate(-50%, -50%); }

.circle-line .line { height: 38px; border-left: 1px dashed rgb(208, 209, 21=
1); position: absolute; top: 22px; left: 50%; transform: translateX(-50%); =
}

.col-activity .list-item-content { flex: 1 1 0%; margin-left: 12px; }

.col-activity .list-item-content-top { margin-bottom: 6px; line-height: 20p=
x; }

.col-activity .list-item-status { background: linear-gradient(rgb(44, 184, =
255) 0%, rgb(40, 87, 255) 100%); border-radius: 2px; color: rgb(255, 255, 2=
55); font-size: 11px; padding: 0px 6px; display: inline-block; }

.col-activity .list-item-status span { vertical-align: middle; }

.col-activity .list-item-status icon { margin-top: -1px; }

.col-activity .list-item-status-live { background: rgb(208, 208, 208); colo=
r: rgb(37, 38, 50); }

.col-activity .list-item-status-back { background: linear-gradient(rgb(138,=
 204, 216) 0%, rgb(82, 157, 175) 100%); }

.col-activity .list-item-time { color: rgba(51, 51, 51, 0.9); font-size: 11=
px; float: right; }

.col-activity .list-item-content-name { font-size: var(--fontSize); color: =
rgb(37, 38, 49); transition: 0.2s linear; }

.col-activity .list-item:hover .list-item-content-name { color: rgb(40, 87,=
 255); font-size: var(--fontSize); font-weight: 500; }
