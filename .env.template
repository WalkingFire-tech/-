# ========================================
# 外脑（远程模型）配置模板
# ========================================
# 
# 使用说明：
# 1. 将此文件重命名为 .env
# 2. 填入你的API密钥
# 3. 重启服务
#

# ----------------------------------------
# OpenAI API (推荐)
# ----------------------------------------
# 用途: GPT-4o-mini - 通用对话、复杂推理
# 费取: https://platform.openai.com/api-keys
# 费用: 约 $0.15/百万tokens
OPENAI_API_KEY=sk-your-openai-key-here

# ----------------------------------------
# DeepSeek API (推荐，性价比高)
# ----------------------------------------
# 用途: DeepSeek-Chat - 代码生成、对话
# 获取: https://platform.deepseek.com/
# 费用: 约 ¥1/百万tokens
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# ----------------------------------------
# 其他可选配置
# ----------------------------------------

# Anthropic Claude (可选)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini (可选)
# GOOGLE_API_KEY=your-google-key-here

# ========================================
# 配置完成后:
# 1. 保存此文件
# 2. 重启服务: python backend/main.py
# 3. 查看日志确认加载成功
# ========================================