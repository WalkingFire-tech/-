# 外部学习配置
# 请在此文件中配置真实的API密钥

# 搜索引擎配置（Google Custom Search API）
SEARCH_API_KEY=your_google_api_key_here
SEARCH_ENGINE_ID=your_search_engine_id_here

# LLM配置（用于调用更强的AI模型）
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4
LLM_BASE_URL=https://api.openai.com/v1

# 说明：
# 1. Google Custom Search API:
#    - 访问 https://developers.google.com/custom-search/v1/introduction
#    - 创建API密钥和搜索引擎ID
#
# 2. LLM API:
#    - 可以使用OpenAI、Claude或其他兼容API
#    - 设置LLM_BASE_URL可以切换到其他服务
#
# 3. 如果不配置，系统将使用模拟模式进行学习