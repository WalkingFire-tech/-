# 联盟拓荒者 - 环境变量配置示例
# 复制此文件为 .env 并填入你的API Key

# OpenAI API Key (可选)
# 用于访问GPT-4o-mini等OpenAI模型
OPENAI_API_KEY=sk-your-openai-api-key-here

# DeepSeek API Key (可选)
# 用于访问DeepSeek Chat和DeepSeek Coder模型
# 如果不设置,将使用OPENAI_API_KEY
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Ollama服务地址 (可选)
# 默认: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434

# 全局超时时间 (可选)
# 默认: 120秒
# CAMPFIRE_TIMEOUT=120